# ====================================================================
# CampusCollab Production Environment Variables
# ====================================================================

# Base Application URL (e.g. your Render or custom domain)
NEXT_PUBLIC_APP_URL=https://campuscollab-rx9f.onrender.com

# Node Environment
NODE_ENV=production

# AWS Cloud Integration (DynamoDB & Serverless)
# These enable live persistence in Amazon DynamoDB
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_TABLE_NAME=workshop-campuscollab-db

# AWS IAM Credentials (Optional for local testing if AWS CLI is configured)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token (if using temporary credentials)
